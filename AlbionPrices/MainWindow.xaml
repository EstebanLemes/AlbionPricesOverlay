                        </StackPanel>

                    </StackPanel>

                    <Border x:Name="MarketCityPanel" Grid.Column="2" Background="#101317" BorderBrush="#252A31"
                            BorderThickness="1" CornerRadius="5" Padding="8,7">
                    <StackPanel>
                        <TextBlock Text="MERCADO POR CIUDAD" Foreground="#8894A0" FontSize="8"
                                   FontWeight="Bold" Margin="0,0,0,5"/>
                        <!-- Cities list -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#555" FontSize="8"/>
                            <TextBlock Grid.Column="1" Text="Ord. Venta" Foreground="#4CAF50" FontSize="8" FontWeight="Bold" Width="75" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Ord. Compra" Foreground="#FF7550" FontSize="8" FontWeight="Bold" Width="75"/>
                        </Grid>
                        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding City}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="75">
                                                <TextBlock Text="{Binding BuyAtFull}" Foreground="#4CAF50" FontSize="11"/>
                                                <TextBlock Text="{Binding BuyAtAgo}" Foreground="#4CAF50" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MinWidth="75">
                                                <TextBlock Text="{Binding SellAtFull}" Foreground="#FF7550" FontSize="11"/>
                                                <TextBlock Text="{Binding SellAtAgo}" Foreground="#FF7550" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                    </Border>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Text="" Foreground="#FF4444" FontSize="11" TextAlignment="Center" IsVisible="False" Margin="0,8"/>
                </StackPanel>

                <!-- ═══════════════════ CRAFTING MODE ═══════════════════ -->
                <StackPanel x:Name="CraftingModeContent" IsVisible="False">

                    <!-- Sub-mode tabs -->
                    <Border Background="#101317" BorderBrush="#252A31" BorderThickness="1"
                            CornerRadius="5" Padding="4" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CraftSubBtn"  Content="Crafteo"  Width="86" Height="28" FontSize="10" FontWeight="Bold"
                                Padding="8,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FF7550" Foreground="White" BorderThickness="0" Margin="0,0,4,0"
                                Click="CraftSubMode_Click"/>
                        <Button x:Name="RefineSubBtn" Content="Refinado" Width="86" Height="28" FontSize="10"
                                Padding="8,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#78828E" BorderThickness="0" Margin="0,0,4,0"
                                Click="RefineSubMode_Click"/>
                        <Button x:Name="EnchantSubBtn" Content="Encant." Width="86" Height="28" FontSize="10"
                                Padding="8,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#78828E" BorderThickness="0" Margin="0,0,4,0"
                                Click="EnchantSubMode_Click"/>
                        <Button x:Name="RouteSubBtn"  Content="Rutas"   Width="86" Height="28" FontSize="10"
                                Padding="8,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#78828E" BorderThickness="0"
                                Click="RouteSubMode_Click"/>
                    </StackPanel>
                    </Border>

