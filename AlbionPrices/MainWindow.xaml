<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AlbionPrices.MainWindow"
        Title="AlbionPrices"
        Width="430"
        MinWidth="420" MinHeight="220"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="#E6101012" BorderBrush="#FF7550" BorderThickness="2" CornerRadius="8"
            BoxShadow="0 0 15 0 #99FF7550">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#FF1A1520" CornerRadius="6,6,0,0" PointerPressed="TitleBar_PointerPressed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="AlbionPrices" Foreground="#FF7550" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#555" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Sin conexion en tiempo real"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PriceModeBtn"   Content="Precios"  Width="46" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FF7550" Foreground="White" BorderThickness="0"
                                FontSize="9" FontWeight="Bold" Margin="0,0,2,0" Click="PriceMode_Click"/>
                        <Button x:Name="CraftingModeBtn" Content="Craft"   Width="40" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,2,0" Click="CraftingMode_Click"/>
                        <Button x:Name="WatchModeBtn"   Content="Watch"    Width="40" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,2,0" Click="WatchMode_Click"/>
                        <Button x:Name="PlayerModeBtn"  Content="Jugador"  Width="46" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,2,0" Click="PlayerMode_Click"/>
                        <Button x:Name="FlipModeBtn"    Content="Flip"     Width="40" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,2,0" Click="FlipMode_Click"/>
                        <Button x:Name="IslandModeBtn"  Content="Isla"     Width="40" Height="20"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,6,0" Click="IslandMode_Click"/>
                        <Button Content="_" Width="32" Height="32" Padding="0" MinHeight="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#888" FontWeight="Bold" Click="MinimizeButton_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="15">

                <!-- Shared: update banner -->
                <TextBlock x:Name="UpdateBanner" Text="Nueva version disponible" Foreground="#FF7550" FontSize="11"
                           FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"
                           Cursor="Hand" IsVisible="False" PointerReleased="UpdateBanner_PointerReleased"/>

                <!-- Shared: server + gold on one row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Servidor:" Foreground="#555" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="RegionNABtn" Content="NA" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                                Padding="4,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="1" BorderBrush="#333"
                                Margin="0,0,3,0" Click="RegionNA_Click"/>
                        <Button x:Name="RegionEUBtn" Content="EU" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                                Padding="4,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FF7550" Foreground="White" BorderThickness="1" BorderBrush="#FF7550"
                                Margin="0,0,3,0" Click="RegionEU_Click"/>
                        <Button x:Name="RegionASBtn" Content="AS" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                                Padding="4,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="1" BorderBrush="#333"
                                Click="RegionAS_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="GoldPriceRow" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" IsVisible="False">
                        <TextBlock Text="&#x2B21; " Foreground="#FFD700" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GoldPriceText" Foreground="#FFD700" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" s/oro" Foreground="#555" FontSize="8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════ PRICE MODE ═══════════════════ -->
                <StackPanel x:Name="PriceModeContent">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ItemInput" Background="#1A1A1A" Foreground="White" BorderBrush="#444"
                                 FontSize="12" Padding="8,6" Watermark="Nombre del item..."
                                 KeyDown="ItemInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Check" Background="#FF7550" Foreground="White"
                                BorderThickness="0" Padding="15,6" Margin="5,0,0,0" Click="CheckButton_Click"/>
                    </Grid>

                    <!-- Recent searches -->
                    <StackPanel x:Name="RecentSearchesSection" IsVisible="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="RECIENTES" Foreground="#555" FontSize="8" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="ClearHistoryBtn" Content="borrar" FontSize="7" Height="14" Padding="5,0" MinHeight="0"
                                    Background="Transparent" Foreground="#444" BorderThickness="1" BorderBrush="#333"
                                    Click="ClearHistory_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="RecentSearchChips"/>
                    </StackPanel>

                    <!-- Favorites -->
                    <StackPanel x:Name="FavoritesSection" IsVisible="False" Margin="0,0,0,8">
                        <TextBlock Text="FAVORITOS" Foreground="#FFD700" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="FavoriteChips"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Text="Escribi el nombre del item" Foreground="#AAA" FontSize="11" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DebugText" Text="" Foreground="#555" FontSize="9" TextAlignment="Center" Margin="0,2" IsVisible="False"/>

                    <StackPanel x:Name="ItemInfoPanel" IsVisible="False">

                        <!-- Item header: icon + name/id + favorite star + watchlist + -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" Background="#1A1A1A" Margin="0,0,10,0">
                                <Image x:Name="ItemIcon" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ItemNameText" Text="" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ItemIdText" Text="" Foreground="#888" FontSize="10"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="FavoriteBtn" Content="&#9734;" Width="26" Height="26"
                                    Padding="0" MinHeight="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" Foreground="#FFD700" BorderThickness="0"
                                    FontSize="16" VerticalAlignment="Center" Click="FavoriteBtn_Click"/>
                            <Button Grid.Column="3" x:Name="AddToWatchlistBtn" Content="+" Width="26" Height="26"
                                    Padding="0" MinHeight="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" Foreground="#FF7550" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                    Click="AddToWatchlist_Click" ToolTip.Tip="Agregar al Watchlist"/>
                        </Grid>

                        <!-- Tier / Enchantment selectors -->
                        <StackPanel x:Name="TierEnchantPanel" IsVisible="False" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Tier" Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="TierButtonsPanel"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Encant." Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="EnchantButtonsPanel"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quality selector -->
                        <StackPanel x:Name="QualityPanel" IsVisible="False" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estado" Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="QualityButtonsPanel"/>
                                <Button x:Name="CompareQualitiesBtn" Content="Comparar" Height="22" Padding="6,0" MinHeight="0"
                                        FontSize="8" Background="Transparent" Foreground="#888"
                                        BorderThickness="1" BorderBrush="#444" Margin="6,0,0,0"
                                        Click="CompareQualities_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quality comparison panel -->
                        <Border x:Name="QualityComparePanel" IsVisible="False"
                                Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="COMPARAR ESTADOS" Foreground="#888" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="×" Width="16" Height="16" Padding="0" MinHeight="0" Margin="6,0,0,0"
                                            Background="Transparent" Foreground="#666" BorderThickness="0" FontSize="10"
                                            Click="QualityCompareClose_Click"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Normal" Foreground="#888" FontSize="8" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="QCBuyNormal"  Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="QCSellNormal" Foreground="#FF5722" FontSize="9"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Buena" Foreground="#888" FontSize="8" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="QCBuyGood"  Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="QCSellGood" Foreground="#FF5722" FontSize="9"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Destacada" Foreground="#888" FontSize="8" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="QCBuyOut"  Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="QCSellOut" Foreground="#FF5722" FontSize="9"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Best buy / sell / instant side by side -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="6,7">
                                <StackPanel>
                                    <TextBlock Text="MEJOR COMPRA" Foreground="#4CAF50" FontWeight="Bold" FontSize="8" Margin="0,0,0,1"/>
                                    <TextBlock Text="venta más baja" Foreground="#4CAF50" FontSize="7" Opacity="0.55" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="BestBuyCityText" Text="" Foreground="#4CAF50" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BestBuyPriceText" Text="" Foreground="#4CAF50" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="BestBuyVolumeText" Text="" Foreground="#4CAF50" FontSize="8" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="4" Padding="6,7">
                                <StackPanel>
                                    <TextBlock Text="MEJOR VENTA" Foreground="#FF5722" FontWeight="Bold" FontSize="8" Margin="0,0,0,1"/>
                                    <TextBlock Text="venta más alta" Foreground="#FF5722" FontSize="7" Opacity="0.55" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="BestSellCityText" Text="" Foreground="#FF5722" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BestSellPriceText" Text="" Foreground="#FF5722" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="BestSellVolumeText" Text="" Foreground="#FF5722" FontSize="8" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#22FFFFFF" CornerRadius="4" Padding="6,7">
                                <StackPanel>
                                    <TextBlock Text="VENTA RÁPIDA" Foreground="#FFD700" FontWeight="Bold" FontSize="8" Margin="0,0,0,1"/>
                                    <TextBlock Text="compra más alta" Foreground="#FFD700" FontSize="7" Opacity="0.55" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="BestInstantCityText" Text="" Foreground="#FFD700" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BestInstantPriceText" Text="" Foreground="#FFD700" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="BestInstantVolumeText" Text="" Foreground="#FFD700" FontSize="8" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Flip calculator -->
                        <Border x:Name="FlipCalcPanel" IsVisible="False"
                                Background="#1AFFD700" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="FLIP OPTIMO" Foreground="#FFD700" FontWeight="Bold" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock x:Name="FlipRouteText" Foreground="#AAA" FontSize="10" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ganancia: " Foreground="#888" FontSize="11"/>
                                    <TextBlock x:Name="FlipProfitText" Foreground="#FFD700" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="FlipMarginText" Foreground="#666" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Price history sparkline -->
                        <StackPanel x:Name="PriceHistoryPanel" IsVisible="False" Margin="0,0,0,8">
                            <TextBlock x:Name="SparklineTitleText" Text="HISTORIAL" Foreground="#555"
                                       FontSize="8" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Canvas x:Name="SparklineCanvas" Height="50" Background="#0AFFFFFF"/>
                        </StackPanel>

                        <!-- Cities list -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#555" FontSize="8"/>
                            <TextBlock Grid.Column="1" Text="Ord. Venta" Foreground="#4CAF50" FontSize="8" FontWeight="Bold" Width="75" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Ord. Compra" Foreground="#FF7550" FontSize="8" FontWeight="Bold" Width="75"/>
                        </Grid>
                        <ItemsControl x:Name="CitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding City}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="75">
                                                <TextBlock Text="{Binding BuyAtFull}" Foreground="#4CAF50" FontSize="11"/>
                                                <TextBlock Text="{Binding BuyAtAgo}" Foreground="#4CAF50" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MinWidth="75">
                                                <TextBlock Text="{Binding SellAtFull}" Foreground="#FF7550" FontSize="11"/>
                                                <TextBlock Text="{Binding SellAtAgo}" Foreground="#FF7550" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Text="" Foreground="#FF4444" FontSize="11" TextAlignment="Center" IsVisible="False" Margin="0,10"/>
                </StackPanel>

                <!-- ═══════════════════ CRAFTING MODE ═══════════════════ -->
                <StackPanel x:Name="CraftingModeContent" IsVisible="False">

                    <!-- Sub-mode tabs -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="CraftSubBtn"  Content="Crafteo"  Width="70" Height="19" FontSize="8" FontWeight="Bold"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FF7550" Foreground="White" BorderThickness="0" Margin="0,0,3,0"
                                Click="CraftSubMode_Click"/>
                        <Button x:Name="RefineSubBtn" Content="Refinado" Width="64" Height="19" FontSize="8"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0" Margin="0,0,3,0"
                                Click="RefineSubMode_Click"/>
                        <Button x:Name="EnchantSubBtn" Content="Encant." Width="56" Height="19" FontSize="8"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0" Margin="0,0,3,0"
                                Click="EnchantSubMode_Click"/>
                        <Button x:Name="RouteSubBtn"  Content="Rutas"   Width="52" Height="19" FontSize="8"
                                Padding="2,0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                Click="RouteSubMode_Click"/>
                    </StackPanel>

                    <!-- ── CRAFTEO ── -->
                    <StackPanel x:Name="CraftSubPanel">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CraftTargetInput" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" FontSize="12" Padding="8,6"
                                     Watermark="Item a craftear..."
                                     KeyDown="CraftTargetInput_KeyDown"/>
                            <Button Grid.Column="1" Content="Buscar" Background="#FF7550" Foreground="White"
                                    BorderThickness="0" Padding="12,6" Margin="5,0,0,0"
                                    Click="CraftSearchTarget_Click"/>
                        </Grid>

                        <Border x:Name="CraftTargetPanel" IsVisible="False"
                                Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="CraftTargetIcon" Width="36" Height="36" Stretch="Uniform" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CraftTargetNameText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CraftTargetIdText" Foreground="#888" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Mejor ord. venta" Foreground="#555" FontSize="8" TextAlignment="Right"/>
                                    <TextBlock x:Name="CraftTargetSellText" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" TextAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <TextBlock Text="Rinde:" Foreground="#555" FontSize="8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="CraftYieldInput" Text="1" Width="36" Height="18"
                                                 FontSize="9" Background="#1A1A1A" Foreground="White"
                                                 BorderBrush="#444" Padding="4,1"
                                                 TextChanged="CraftYield_Changed"/>
                                        <TextBlock Text="ud." Foreground="#555" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="CraftMaterialsHeader" IsVisible="False" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MATERIALES" Foreground="#555" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="CraftAddMaterialBtn" Content="+ agregar"
                                    FontSize="8" Height="18" Padding="8,0" MinHeight="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" Foreground="#FF7550"
                                    BorderThickness="1" BorderBrush="#FF7550"
                                    Click="CraftAddMaterial_Click"/>
                        </Grid>

                        <StackPanel x:Name="CraftMaterialsPanel"/>

                        <Border x:Name="CraftAddMaterialRow" IsVisible="False"
                                Background="#1AFF7550" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CraftMaterialNameInput" Background="#1A1A1A" Foreground="White"
                                         BorderBrush="#555" FontSize="11" Padding="6,4"
                                         KeyDown="CraftMaterialInput_KeyDown"/>
                                <TextBox Grid.Column="1" x:Name="CraftMaterialQtyInput" Background="#1A1A1A"
                                         Foreground="White" BorderBrush="#555" FontSize="11"
                                         Padding="6,4" Margin="4,0,0,0" Text="1"
                                         KeyDown="CraftMaterialInput_KeyDown"/>
                                <Button Grid.Column="2" Content="OK" Width="32" Height="30" Padding="0" MinHeight="0"
                                        FontSize="9" FontWeight="Bold" Margin="4,0,0,0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="#FF7550" Foreground="White" BorderThickness="0"
                                        Click="CraftConfirmMaterial_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CraftSummaryPanel" IsVisible="False"
                                Background="#1AFFD700" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                            <StackPanel Spacing="3">
                                <!-- Header: title + retorno% input + premium toggle -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RESUMEN" Foreground="#FFD700" FontSize="9"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Retorno:" Foreground="#888" FontSize="8"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBox Grid.Column="2" x:Name="CraftReturnRateInput" Height="18" FontSize="8"
                                             Background="#1A1A1A" Foreground="White" BorderBrush="#444"
                                             Padding="4,1" Watermark="0"
                                             TextChanged="CraftReturn_Changed"/>
                                    <TextBlock Grid.Column="3" Text="%" Foreground="#888" FontSize="8"
                                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="Premium:" Foreground="#888" FontSize="8"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Grid.Column="5" x:Name="CraftPremiumBtn" Content="No"
                                            Height="18" FontSize="8" Padding="4,0" MinHeight="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Background="Transparent" Foreground="#666"
                                            BorderThickness="1" BorderBrush="#444"
                                            Click="CraftPremium_Click"/>
                                </Grid>

                                <!-- Row: Materiales brutos -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CraftMaterialsLabel" Text="Costo materiales:"
                                               Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftTotalCostText"
                                               Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Row: Retorno (solo visible cuando returnRate > 0) -->
                                <Grid x:Name="CraftReturnRow" IsVisible="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CraftReturnLabel" Text="Retorno (0%):"
                                               Foreground="#4CAF50" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftReturnText"
                                               Foreground="#4CAF50" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Row: Costo neto (solo visible cuando returnRate > 0) -->
                                <Grid x:Name="CraftNetCostRow" IsVisible="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Costo neto:" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftNetCostText"
                                               Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row: Precio venta -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Precio venta:" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftSellPriceText"
                                               Foreground="#4CAF50" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Row: Impuesto -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CraftTaxLabel" Text="Impuesto (8%):"
                                               Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftTaxText"
                                               Foreground="#FF4444" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Row: Ganancia neta -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GANANCIA NETA:" Foreground="#CCC"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="CraftProfitText"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CraftStatusText" Text="" Foreground="#555" FontSize="10"
                                   TextAlignment="Center" Margin="0,8,0,0" IsVisible="False"/>
                    </StackPanel>

                    <!-- ── REFINADO ── -->
                    <StackPanel x:Name="RefineSubPanel" IsVisible="False">
                        <TextBlock Text="Recurso:" Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RefineResourcePanel" Margin="0,0,0,8"/>
                        <TextBlock Text="Tier:" Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RefineTierPanel" Margin="0,0,0,8"/>
                        <TextBlock Text="Ciudad de refinado:" Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RefineCityPanel" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foco:" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" x:Name="RefineFocusBtn" Content="No" Width="38" Height="26"
                                    FontSize="9" Padding="4,0" MinHeight="0" Margin="0,0,10,0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" Foreground="#666" BorderThickness="1" BorderBrush="#444"
                                    Click="RefineFocus_Click"/>
                            <TextBox Grid.Column="2" x:Name="RefineQtyInput" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" FontSize="11" Padding="6,4" Text="10" Watermark="Cant."/>
                            <Button Grid.Column="3" Content="Calcular" Background="#FF7550" Foreground="White"
                                    BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Click="RefineCalc_Click"/>
                        </Grid>
                        <TextBlock x:Name="RefineStatusText" Text="" Foreground="#555" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,4" IsVisible="False"/>
                        <Border x:Name="RefineResultPanel" IsVisible="False"
                                Background="#1A4CAF50" BorderBrush="#2A4CAF50" BorderThickness="1"
                                CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="RefineResultTitle" Foreground="#4CAF50" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="19"/>
                                        <RowDefinition Height="19"/>
                                        <RowDefinition Height="19"/>
                                        <RowDefinition Height="19"/>
                                        <RowDefinition Height="19"/>
                                        <RowDefinition Height="21"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tasa retorno:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="RefineRateText" Foreground="#FFD700" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="Crudo (×2 por ud.):" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RefineRawCostText" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" x:Name="RefineLowerLabel" Text="Refinado inferior:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RefineLowerCostText" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="Costo neto total:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RefineTotalCostText" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Text="Precio venta refinado:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RefineRevText" Foreground="#4CAF50" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Text="GANANCIA NETA:" Foreground="#CCC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RefineProfitText" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── ENCHANTING ── -->
                    <StackPanel x:Name="EnchantSubPanel" IsVisible="False">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EnchantItemInput" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" FontSize="12" Padding="8,6"
                                     Watermark="Item base (ej. Claymore T5)..."
                                     KeyDown="EnchantItemInput_KeyDown"/>
                            <Button Grid.Column="1" Content="Buscar" Background="#FF7550" Foreground="White"
                                    BorderThickness="0" Padding="12,6" Margin="5,0,0,0"
                                    Click="EnchantSearch_Click"/>
                        </Grid>
                        <TextBlock x:Name="EnchantStatusText" Text="" Foreground="#555" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,4" IsVisible="False"/>
                        <!-- Result rows built in code-behind -->
                        <StackPanel x:Name="EnchantResultPanel"/>
                    </StackPanel>

                    <!-- ── RUTAS ── -->
                    <StackPanel x:Name="RouteSubPanel" IsVisible="False">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RouteItemInput" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" FontSize="11" Padding="6,5"
                                     Watermark="Nombre del item..."/>
                            <TextBox Grid.Column="1" x:Name="RouteQtyInput" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" FontSize="11" Padding="6,5" Margin="4,0,0,0"
                                     Text="1" Watermark="Cant."/>
                            <Button Grid.Column="2" Content="+" Width="30" Height="32" Padding="0" MinHeight="0"
                                    FontSize="16" FontWeight="Bold" Margin="4,0,0,0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="#FF7550" Foreground="White" BorderThickness="0"
                                    Click="RouteAddItem_Click"/>
                        </Grid>
                        <StackPanel x:Name="RouteItemsPanel" Margin="0,0,0,6"/>
                        <Grid x:Name="RouteCalcRow" IsVisible="False" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RouteItemCountText" Foreground="#555" FontSize="9" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Calcular mejor ciudad" Background="#FF7550" Foreground="White"
                                    BorderThickness="0" Padding="12,6" Click="RouteCalc_Click"/>
                        </Grid>
                        <TextBlock x:Name="RouteStatusText" Text="" Foreground="#555" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,4" IsVisible="False"/>
                        <StackPanel x:Name="RouteResultPanel"/>
                    </StackPanel>

                </StackPanel>

                <!-- ═══════════════════ WATCHLIST MODE ═══════════════════ -->
                <StackPanel x:Name="WatchModeContent" IsVisible="False">

                    <!-- Alert banner -->
                    <Border x:Name="AlertBanner" IsVisible="False"
                            Background="#33FF4444" BorderBrush="#FF4444" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlertBannerText" Foreground="#FF6666" FontSize="10"
                                       FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="x" Width="20" Height="20" Padding="0" MinHeight="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" Foreground="#666" BorderThickness="0"
                                    FontSize="10" Click="AlertBannerDismiss_Click"/>
                        </Grid>
                    </Border>

                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WATCHLIST" Foreground="#FF7550" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="WatchCountdownText" Foreground="#555"
                                   FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="WatchRefreshBtn" Content="&#8635;" Width="22" Height="22"
                                Padding="0" MinHeight="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#FF7550" BorderThickness="0"
                                FontSize="16" Click="WatchRefresh_Click" ToolTip.Tip="Actualizar ahora"/>
                    </Grid>

                    <!-- Empty state -->
                    <TextBlock x:Name="WatchEmptyText"
                               Text="Busca un item en Precios y presiona + para agregar al watchlist."
                               Foreground="#555" FontSize="11" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,20,0,20"/>

                    <!-- Items built in code-behind -->
                    <StackPanel x:Name="WatchItemsPanel"/>

                </StackPanel>

                <!-- ═══════════════════ PLAYER MODE ═══════════════════ -->
                <StackPanel x:Name="PlayerModeContent" IsVisible="False">
                    <TextBlock Text="Nombre del jugador:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PlayerInput" Background="#1A1A1A" Foreground="White" BorderBrush="#444"
                                 FontSize="12" Padding="8,6" KeyDown="PlayerInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Buscar" Background="#FF7550" Foreground="White"
                                BorderThickness="0" Padding="12,6" Margin="5,0,0,0" Click="PlayerSearchButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="PlayerStatusText" Text="" Foreground="#AAA" FontSize="11"
                               TextAlignment="Center" Margin="0,0,0,8" IsVisible="False"/>

                    <ListBox x:Name="PlayerResultsList" Background="Transparent" BorderThickness="0"
                             Margin="0,0,0,8" IsVisible="False"
                             SelectionChanged="PlayerResultsList_SelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,2" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GuildName}" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Player card -->
                    <StackPanel x:Name="PlayerCard" IsVisible="False">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="6" Background="#1A1A1A"
                                    BorderBrush="#333" BorderThickness="1">
                                <Image x:Name="PlayerAvatarImg" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerNameText" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="PlayerGuildText" Foreground="#888" FontSize="11"/>
                                <TextBlock x:Name="PlayerAllianceText" Foreground="#FF7550" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="IP: " Foreground="#555" FontSize="9"/>
                                    <TextBlock x:Name="PlayerIPText" Foreground="#AAA" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="KILLS FAME" Foreground="#4CAF50" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerKillFameText" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="DEATH FAME" Foreground="#FF4444" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerDeathFameText" Foreground="#FF4444" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="K/D RATIO" Foreground="#FF7550" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerRatioText" Foreground="#FF7550" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="PvE FAME" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerPvEText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="RECOLECCION" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerGatherText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CRAFTING" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerCraftText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="LastEquipPanel" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="ULTIMO SET" Foreground="#666" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastSeenAgoText" Foreground="#444" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid x:Name="EquipmentSlotsGrid" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                </Grid.RowDefinitions>
                            </Grid>
                            <TextBlock x:Name="SetValueText" Foreground="#FFD700" FontSize="9"
                                       TextAlignment="Center" Margin="0,5,0,0" IsVisible="False"/>
                        </StackPanel>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>

                                <StackPanel x:Name="RecentKillsPanel" IsVisible="False" Margin="0,0,0,8">
                                    <TextBlock Text="KILLS RECIENTES" Foreground="#4CAF50" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="KillsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,2"
                                                        Cursor="Hand" PointerReleased="KillEntry_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding VictimName}" Foreground="#66CC77" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding VictimGuild}" Foreground="#666" FontSize="9" VerticalAlignment="Center" Margin="6,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#555" FontSize="9" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="RecentDeathsPanel" IsVisible="False">
                                    <TextBlock Text="ULTIMAS MUERTES" Foreground="#FF4444" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="DeathsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding KillerName}" Foreground="#FF6666" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding KillerGuild}" Foreground="#666" FontSize="9" VerticalAlignment="Center" Margin="6,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#555" FontSize="9" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                    </StackPanel>

                    <TextBlock x:Name="PlayerErrorText" Text="" Foreground="#FF4444" FontSize="11"
                               TextAlignment="Center" IsVisible="False" Margin="0,8"/>
                </StackPanel>

                <!-- ═══════════════════ FLIP MODE ═══════════════════ -->
                <StackPanel x:Name="FlipModeContent" IsVisible="False">

                    <!-- Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OPORTUNIDADES DE FLIP" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="FlipLastScanText" Text="Sin escanear" Foreground="#555" FontSize="8" VerticalAlignment="Center"/>
                                <Button Content="[catálogo]" Padding="0" Height="12"
                                        Background="Transparent" Foreground="#444" BorderThickness="0"
                                        FontSize="8" Cursor="Hand" Click="OpenCatalog_Click"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ScanNowBtn" Content="Escanear" Width="70" Height="22"
                                Background="#FF7550" Foreground="White" BorderThickness="0" CornerRadius="4"
                                FontSize="9" FontWeight="Bold" Click="ScanNow_Click"/>
                    </Grid>

                    <!-- Filters -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Profit mín:" Foreground="#888" FontSize="9"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="MinFlipProfitInput" Text="1000" Width="65" Height="20"
                                     FontSize="9" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" Padding="5,2"
                                     TextChanged="FlipProfitFilter_Changed"/>
                            <TextBlock Text="Flete%:" Foreground="#888" FontSize="9"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="TransportPctInput" Text="" Width="36" Height="20"
                                     FontSize="9" Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#444" Padding="5,2" Watermark="0"
                                     TextChanged="FlipTransport_Changed"/>
                            <CheckBox x:Name="PremiumCheckBox" Content="Premium" IsChecked="False"
                                      Foreground="#AAAAAA" FontSize="9" Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="FlipPremium_Changed" Unchecked="FlipPremium_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="FlipCountText" Text=""
                                   Foreground="#555" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Category + city selectors -->
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Categ.:" Foreground="#888" FontSize="9"
                                       Width="46" VerticalAlignment="Center"/>
                            <WrapPanel x:Name="FlipCategoryPanel"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Origen:" Foreground="#888" FontSize="9"
                                       Width="46" VerticalAlignment="Center"/>
                            <WrapPanel x:Name="FlipOriginPanel"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Destino:" Foreground="#888" FontSize="9"
                                       Width="46" VerticalAlignment="Center"/>
                            <WrapPanel x:Name="FlipDestPanel"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress -->
                    <TextBlock x:Name="FlipStatusText" Text="" Foreground="#888" FontSize="9"
                               TextAlignment="Center" Margin="0,0,0,6" IsVisible="False"/>

                    <!-- Results list -->
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FlipList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,6"
                                            Margin="0,2" Cursor="Hand"
                                            PointerReleased="FlipItem_Click">
                                        <StackPanel>
                                            <!-- Nombre + tier + calidad -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ItemName}" Foreground="White"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TierLabel}" Foreground="#888"
                                                           FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding QualityLabel}" Foreground="#B8860B"
                                                           FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Compra -->
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="compra" Foreground="#555" FontSize="7"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding BuyCity}" Foreground="#4CAF50" FontSize="9"/>
                                                <TextBlock Text="{Binding BuyPriceLabel}" Foreground="#4CAF50" FontSize="9" Margin="4,0,0,0"/>
                                                <TextBlock Text="{Binding BuyVolumeLabel}" Foreground="#4CAF50" FontSize="8" Opacity="0.55" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <!-- Venta directa (dir.) -->
                                            <Grid IsVisible="{Binding HasInstantSell}" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="dir." Foreground="#FF5722" FontSize="7"
                                                                   Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding InstantSellCity}" Foreground="#FF5722" FontSize="9"/>
                                                        <TextBlock Text="{Binding InstantSellPriceLabel}" Foreground="#FF5722" FontSize="9" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                                        <TextBlock Text="{Binding InstantSellVolumeLabel}" Foreground="#FF5722" FontSize="8" Opacity="0.55" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock IsVisible="{Binding HasInstantSellOrderRef}"
                                                               Text="{Binding InstantSellOrderRefLabel}"
                                                               Foreground="#FF8A65" FontSize="8" Opacity="0.7" Margin="18,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InstantProfitLabel}" Foreground="#FFD700"
                                                               FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding InstantProfitPctLabel}" Foreground="#FFD700"
                                                               FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.75"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Orden de venta (ord.) -->
                                            <Grid IsVisible="{Binding HasOrderSell}" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="ord." Foreground="#FF8A65" FontSize="7"
                                                                   Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding OrderSellCity}" Foreground="#FF8A65" FontSize="9"/>
                                                        <TextBlock Text="{Binding OrderSellPriceLabel}" Foreground="#FF8A65" FontSize="9" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                                        <TextBlock Text="{Binding OrderSellVolumeLabel}" Foreground="#FF8A65" FontSize="8" Opacity="0.55" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock IsVisible="{Binding HasOrderSellInstantRef}"
                                                               Text="{Binding OrderSellInstantRefLabel}"
                                                               Foreground="#FF5722" FontSize="8" Opacity="0.7" Margin="18,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OrderProfitLabel}" Foreground="#FFCC44"
                                                               FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding OrderProfitPctLabel}" Foreground="#FFCC44"
                                                               FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.75"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Flip journal -->
                    <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Journal header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="HISTORIAL DE FLIPS" Foreground="#444"
                                               FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="limpiar" Padding="4,0" Height="14"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#333" FontSize="7" Margin="0,0,4,0"
                                        Click="FlipJournalClear_Click"/>
                                <Button x:Name="FlipJournalToggleBtn" Content="▼" Grid.Column="2"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#444" FontSize="9" Padding="2,0" Height="14"
                                        Click="FlipJournalToggle_Click"/>
                            </Grid>
                            <!-- Journal body (collapsed by default) -->
                            <StackPanel x:Name="FlipJournalBody" IsVisible="False" Margin="0,4,0,0">
                                <TextBlock x:Name="FlipJournalTotalText" Text="Sin registros aún"
                                           Foreground="#555" FontSize="8" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="FlipJournalList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DateLabel}"
                                                               Foreground="#444" FontSize="8"
                                                               VerticalAlignment="Center" Width="65"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ItemName}" Foreground="#AAA" FontSize="9"/>
                                                        <TextBlock Text="{Binding RouteLabel}" Foreground="#555" FontSize="8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ProfitLabel}"
                                                               Foreground="#4CAF50" FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ═══════════════════ ISLAND MODE ═══════════════════ -->
                <StackPanel x:Name="IslandModeContent" IsVisible="False">

                    <!-- Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GUÍA DE ISLAS" Foreground="#FF7550" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="IslandFetchPricesBtn" Content="Ver precios" Height="22" FontSize="9"
                                    Background="#1A4CAF50" Foreground="#4CAF50"
                                    BorderThickness="1" BorderBrush="#4CAF50"
                                    Padding="8,0" Margin="0,0,6,0" Click="IslandFetchPrices_Click"/>
                            <Button x:Name="AddIslandBtn" Content="+ Isla" Height="22" FontSize="9"
                                    Background="#FF7550" Foreground="White" BorderThickness="0"
                                    Padding="8,0" Click="AddIsland_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Add island form -->
                    <Border x:Name="AddIslandForm" IsVisible="False" Background="#18FFFFFF"
                            BorderBrush="#2A3A48" BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Ciudad:" Foreground="#8AABB8" FontSize="8" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="NewIslandCityPanel" Margin="0,0,0,8"/>
                            <TextBlock Text="Tier de isla:" Foreground="#8AABB8" FontSize="8" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="NewIslandTierPanel" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Height="20" FontSize="8"
                                        Background="Transparent" Foreground="#8A9BAA" BorderThickness="0"
                                        Margin="0,0,8,0" Click="AddIslandCancel_Click"/>
                                <Button x:Name="AddIslandConfirmBtn" Content="Agregar" Height="20" FontSize="8"
                                        Background="#FF7550" Foreground="White" BorderThickness="0"
                                        Padding="10,0" Click="AddIslandConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Island cards (populated by code) -->
                    <WrapPanel x:Name="IslandCardsPanel" Orientation="Horizontal"/>

                    <!-- Synergy section -->
                    <StackPanel x:Name="IslandSynergiesPanel" IsVisible="False" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#4CAF50" Width="3" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="SINERGIAS DETECTADAS" Foreground="#4CAF50"
                                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="SynergyItemsPanel"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
