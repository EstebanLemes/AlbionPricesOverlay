                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="6,5">
                                <StackPanel>
                                    <TextBlock Text="MEJOR COMPRA" Foreground="#4CAF50" FontWeight="Bold" FontSize="8" Margin="0,0,0,1"/>
