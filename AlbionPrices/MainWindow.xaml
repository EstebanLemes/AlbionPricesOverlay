<Window x:Class="AlbionPrices.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlbionPrices"
        mc:Ignorable="d"
        Title="AlbionPrices"
        Width="420" Height="Auto"
        MinWidth="400" MinHeight="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Left="100" Top="100">
    <Border Background="#E6101012" BorderBrush="#FF7550" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.6" Color="#FF7550"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#FF1A1520" CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="AlbionPrices" Foreground="#FF7550" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#555" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="Sin conexión en tiempo real"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PriceModeBtn" Content="Precios" Width="54" Height="20"
                                Background="#FF7550" Foreground="White" BorderThickness="0"
                                FontSize="9" FontWeight="Bold" Margin="0,0,2,0" Click="PriceMode_Click"/>
                        <Button x:Name="PlayerModeBtn" Content="Jugador" Width="54" Height="20"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                FontSize="9" Margin="0,0,6,0" Click="PlayerMode_Click"/>
                        <Button Content="_" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Foreground="#888" FontWeight="Bold" Click="MinimizeButton_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="15">

                <!-- Shared: update banner -->
                <TextBlock x:Name="UpdateBanner" Text="Nueva version disponible" Foreground="#FF7550" FontSize="11"
                           FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"
                           Cursor="Hand" MouseLeftButtonUp="UpdateBanner_Click" Visibility="Collapsed"/>

                <!-- Shared: server region selector -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Servidor:" Foreground="#555" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="RegionNABtn" Content="NA" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                            Background="Transparent" Foreground="#666" BorderThickness="1" BorderBrush="#333"
                            Margin="0,0,3,0" Click="RegionNA_Click"/>
                    <Button x:Name="RegionEUBtn" Content="EU" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                            Background="#FF7550" Foreground="White" BorderThickness="1" BorderBrush="#FF7550"
                            Margin="0,0,3,0" Click="RegionEU_Click"/>
                    <Button x:Name="RegionASBtn" Content="AS" Width="36" Height="18" FontSize="9" FontWeight="Bold"
                            Background="Transparent" Foreground="#666" BorderThickness="1" BorderBrush="#333"
                            Click="RegionAS_Click"/>
                </StackPanel>

                <!-- ═══════════════════ PRICE MODE ═══════════════════ -->
                <StackPanel x:Name="PriceModeContent">

                    <!-- Gold price indicator (price mode only) -->
                    <StackPanel x:Name="GoldPriceRow" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="⬡ " Foreground="#FFD700" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GoldPriceText" Foreground="#FFD700" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" s/oro" Foreground="#555" FontSize="8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Nombre del item:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ItemInput" Background="#1A1A1A" Foreground="White" BorderBrush="#444"
                                 FontSize="12" Padding="8,6" KeyDown="ItemInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Check" Background="#FF7550" Foreground="White"
                                BorderThickness="0" Padding="15,6" Margin="5,0,0,0" Click="CheckButton_Click"/>
                    </Grid>

                    <!-- Recent searches -->
                    <StackPanel x:Name="RecentSearchesSection" Visibility="Collapsed" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="RECIENTES" Foreground="#555" FontSize="8" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="ClearHistoryBtn" Content="borrar" FontSize="7" Height="14" Padding="5,0"
                                    Background="Transparent" Foreground="#444" BorderThickness="1" BorderBrush="#333"
                                    Click="ClearHistory_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="RecentSearchChips"/>
                    </StackPanel>

                    <!-- Favorites -->
                    <StackPanel x:Name="FavoritesSection" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="FAVORITOS" Foreground="#FFD700" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="FavoriteChips"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Text="Escribí el nombre del item" Foreground="#AAA" FontSize="11" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DebugText" Text="" Foreground="#555" FontSize="9" TextAlignment="Center" Margin="0,2" Visibility="Collapsed"/>

                    <StackPanel x:Name="ItemInfoPanel" Visibility="Collapsed">

                        <!-- Item header: icon + name/id + favorite star -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" Background="#1A1A1A" Margin="0,0,10,0">
                                <Image x:Name="ItemIcon" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ItemNameText" Text="" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ItemIdText" Text="" Foreground="#888" FontSize="10"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="FavoriteBtn" Content="☆" Width="26" Height="26"
                                    Background="Transparent" Foreground="#FFD700" BorderThickness="0"
                                    FontSize="16" VerticalAlignment="Center" Click="FavoriteBtn_Click"/>
                        </Grid>

                        <!-- Tier / Enchantment selectors -->
                        <StackPanel x:Name="TierEnchantPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Tier" Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="TierButtonsPanel"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Encant." Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="EnchantButtonsPanel"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quality selector -->
                        <StackPanel x:Name="QualityPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estado" Foreground="#666" FontSize="10" VerticalAlignment="Center" Width="44"/>
                                <WrapPanel x:Name="QualityButtonsPanel"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Best buy -->
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="MEJOR COMPRA" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ciudad: " Foreground="#AAA" FontSize="11"/>
                                    <TextBlock x:Name="BestBuyCityText" Text="" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Precio: " Foreground="#AAA" FontSize="11"/>
                                    <TextBlock x:Name="BestBuyPriceText" Text="" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Best sell -->
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="MEJOR VENTA" Foreground="#FF5722" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ciudad: " Foreground="#AAA" FontSize="11"/>
                                    <TextBlock x:Name="BestSellCityText" Text="" Foreground="#FF5722" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Precio: " Foreground="#AAA" FontSize="11"/>
                                    <TextBlock x:Name="BestSellPriceText" Text="" Foreground="#FF5722" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Flip calculator -->
                        <Border x:Name="FlipCalcPanel" Visibility="Collapsed"
                                Background="#1AFFD700" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="FLIP ÓPTIMO" Foreground="#FFD700" FontWeight="Bold" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock x:Name="FlipRouteText" Foreground="#AAA" FontSize="10" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ganancia: " Foreground="#888" FontSize="11"/>
                                    <TextBlock x:Name="FlipProfitText" Foreground="#FFD700" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="FlipMarginText" Foreground="#666" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Price history sparkline -->
                        <StackPanel x:Name="PriceHistoryPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock x:Name="SparklineTitleText" Text="HISTORIAL" Foreground="#555"
                                       FontSize="8" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Canvas x:Name="SparklineCanvas" Height="50" Background="#0AFFFFFF"/>
                        </StackPanel>

                        <!-- Cities list -->
                        <ItemsControl x:Name="CitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding City}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="75">
                                                <TextBlock Text="Ord. Venta" Foreground="#4CAF50" FontSize="8" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding BuyAtLabel}" Foreground="#4CAF50" FontSize="11"/>
                                                <TextBlock Text="{Binding BuyAtAgo}" Foreground="#4CAF50" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MinWidth="75">
                                                <TextBlock Text="Ord. Compra" Foreground="#FF7550" FontSize="8" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SellAtLabel}" Foreground="#FF7550" FontSize="11"/>
                                                <TextBlock Text="{Binding SellAtAgo}" Foreground="#FF7550" FontSize="8" Opacity="0.55"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Text="" Foreground="#FF4444" FontSize="11" TextAlignment="Center" Visibility="Collapsed" Margin="0,10"/>
                </StackPanel>

                <!-- ═══════════════════ PLAYER MODE ═══════════════════ -->
                <StackPanel x:Name="PlayerModeContent" Visibility="Collapsed">
                    <TextBlock Text="Nombre del jugador:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PlayerInput" Background="#1A1A1A" Foreground="White" BorderBrush="#444"
                                 FontSize="12" Padding="8,6" KeyDown="PlayerInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Buscar" Background="#FF7550" Foreground="White"
                                BorderThickness="0" Padding="12,6" Margin="5,0,0,0" Click="PlayerSearchButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="PlayerStatusText" Text="" Foreground="#AAA" FontSize="11"
                               TextAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- Multiple results list -->
                    <ListBox x:Name="PlayerResultsList" Background="Transparent" BorderThickness="0"
                             Margin="0,0,0,8" Visibility="Collapsed"
                             SelectionChanged="PlayerResultsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,2" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GuildName}" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Player card -->
                    <StackPanel x:Name="PlayerCard" Visibility="Collapsed">

                        <!-- Avatar + name/guild/IP/kills -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="6" Background="#1A1A1A"
                                    BorderBrush="#333" BorderThickness="1">
                                <Image x:Name="PlayerAvatarImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerNameText" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="PlayerGuildText" Foreground="#888" FontSize="11"/>
                                <TextBlock x:Name="PlayerAllianceText" Foreground="#FF7550" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="IP: " Foreground="#555" FontSize="9"/>
                                    <TextBlock x:Name="PlayerIPText" Foreground="#AAA" FontSize="9"/>
                                    <TextBlock Text="  Kills: " Foreground="#555" FontSize="9"/>
                                    <TextBlock x:Name="PlayerKillCountText" Foreground="#4CAF50" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Kill Fame / Death Fame / Ratio -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="KILLS FAME" Foreground="#4CAF50" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerKillFameText" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="DEATH FAME" Foreground="#FF4444" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerDeathFameText" Foreground="#FF4444" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="4" Padding="8,6" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="K/D RATIO" Foreground="#FF7550" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerRatioText" Foreground="#FF7550" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- PvE / Gathering / Crafting -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="PvE FAME" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerPvEText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="RECOLECCIÓN" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerGatherText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CRAFTING" Foreground="#888" FontSize="8"/>
                                    <TextBlock x:Name="PlayerCraftText" Foreground="#CCC" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Last equipment set — Albion-style grid layout -->
                        <StackPanel x:Name="LastEquipPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="ÚLTIMO SET" Foreground="#666" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastSeenAgoText" Foreground="#444" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 3-col × 4-row grid matching Albion's in-game inventory screen:
                                 Row 0: [Bolso]    [Cabeza]   [Capa]
                                 Row 1: [MH]       [Armadura] [OH]
                                 Row 2: [Poción]   [Zapatos]  [Comida]
                                 Row 3:            [Montura]             -->
                            <Grid x:Name="EquipmentSlotsGrid" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                </Grid.RowDefinitions>
                            </Grid>
                            <TextBlock x:Name="SetValueText" Foreground="#FFD700" FontSize="9"
                                       TextAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Recent deaths -->
                        <StackPanel x:Name="RecentDeathsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="ÚLTIMAS MUERTES" Foreground="#FF4444" FontSize="8" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl x:Name="DeathsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KillerName}" Foreground="#FF6666" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding KillerGuild}" Foreground="#666" FontSize="9" VerticalAlignment="Center" Margin="6,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#555" FontSize="9" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>

                    <TextBlock x:Name="PlayerErrorText" Text="" Foreground="#FF4444" FontSize="11"
                               TextAlignment="Center" Visibility="Collapsed" Margin="0,8"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
