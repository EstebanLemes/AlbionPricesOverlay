                            <TextBlock Text="Foco:" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" x:Name="RefineFocusBtn" Content="No" Width="38" Height="26"
                                    FontSize="9" Padding="4,0" MinHeight="0" Margin="0,0,10,0"
